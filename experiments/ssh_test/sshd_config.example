# Test-only OpenSSH server for experiments/run_exp3.sh.
# Replace every __REPO_ROOT__ and __TEST_USER__ placeholder before use.
Port 22222
ListenAddress 127.0.0.1
HostKey __REPO_ROOT__/experiments/ssh_test/ssh_host_ed25519_key
PidFile __REPO_ROOT__/experiments/ssh_test/sshd.pid
AuthorizedKeysFile __REPO_ROOT__/experiments/ssh_test/authorized_keys
PasswordAuthentication no
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
PubkeyAuthentication yes
PermitRootLogin no
AllowUsers __TEST_USER__
StrictModes no
AllowAgentForwarding no
AllowTcpForwarding no
X11Forwarding no
PermitTTY no
AuthenticationMethods publickey
PubkeyAcceptedAlgorithms rsa-sha2-256
LogLevel ERROR
